DATABASE_URL="postgresql://postgres:password@localhost:5432/fiscal_dashboard"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-this-too"

# Chave usada para criptografar (AES-256-GCM) o certificado digital A1 (.pfx)
# e a senha das empresas, antes de salvar no banco. Gere com: openssl rand -hex 32
CERT_ENCRYPTION_KEY="64-character-hex-string-generate-with-openssl-rand-hex-32"

PORT=3001
NODE_ENV=development

# Integração automática com Google Drive (captura de XMLs) — ver README para
# o passo a passo de criação da conta de serviço no Google Cloud Console.
# Em dev local, use GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH (caminho do arquivo).
# Em produção/nuvem (sem disco persistente), use GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON
# com o conteúdo inteiro do JSON da chave, colado como uma única linha.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH="/Users/seu-usuario/.secrets/fiscal-dashboard/gdrive-service-account.json"
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"..."}'
GOOGLE_DRIVE_ROOT_FOLDER_ID="1NFNXvOHZGfotWZzeEwpz10MLUhbhiHAe"
